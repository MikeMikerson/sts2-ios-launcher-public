# What stays out of source control: local tools and builds, anything from the game, signing
# material, and local editor files.

# Local tooling, dependencies, build inputs and logs.
.work/
.tools/
.local/
.venv/
analysis/
vendor/
tools/ios-dotnet/
tools/python/
**/bin/
**/obj/
**/.godot/
**/__pycache__/
**/.pytest_cache/
.ruff_cache/
.DS_Store
._*

# Prepared host inputs, generated by setup and Godot's import, none from the game.
src/STS2Mobile.FullGame/staged/
src/STS2Mobile.FullGame/addons/
src/STS2Mobile.FullGame/icon.png
src/STS2Mobile.FullGame/icon.png.import

# Game binaries, packs, archives and media are never source files, wherever they land.
*.dll
*.pdb
*.exe
*.a
*.dylib
*.so
*.pck
*.zip
*.tpz
*.tar.gz
*.dmg
*.png
*.jpg
*.jpeg
*.heic
*.pdf
*.mov
*.mp4

# Signing and local setup choices never belong in source control.
.env
.env.*
*.p12
*.p8
*.pfx
*.pem
*.key
*.mobileprovision
*.provisionprofile
*.certSigningRequest
*.cer
*.der
**/xcuserdata/

# Local editor state.
.idea/
.vscode/
.vs/
*.user
*.swp
*~

# Build and test artifacts produced outside the standard output folders.
DerivedData/
TestResults/
*.xcresult
*.xcarchive/
*.dSYM/
*.ipa
*.log

# Diagnostics can hold usernames, paths, environment variables and device details.
*.binlog
*.jsonl
*.ips
*.crash
*.trace
*.memgraph
